# 构建产物（可由 python build.py build 重建）
dist/

# 形状 fixture 的生成物（由 fixtures/make_vaults.py 确定性重建；只入库生成器 + manifest）
fixtures/vaults/

# 第三方库（Cytoscape vendored；已弃用后不再需要）
/vendor/   # 只忽略仓库根的第三方库目录；web/vendor/katex 是要入库的（KaTeX，见 README §4）

# Python
__pycache__/
*.py[cod]

# 同步日志
*.log

# 同步任务的防重入锁
*.lock
